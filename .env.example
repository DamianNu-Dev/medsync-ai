# ---------------------------------------------------------------------------
# MedSync AI · Configuración del asistente y del escáner de recetas
# ---------------------------------------------------------------------------
# Copia este archivo como `.env` y completa los valores.
# Solo las variables con prefijo EXPO_PUBLIC_ llegan al bundle del cliente.
# No pongas aquí secretos de servidor: en producción, proxya las llamadas
# desde tu backend para no exponer la API key en la app.

# Proveedor compatible con OpenAI (Groq, OpenRouter, Together, etc.)
EXPO_PUBLIC_AI_BASE_URL=https://api.groq.com/openai/v1
EXPO_PUBLIC_AI_API_KEY=TU_GROQ_API_KEY_AQUI
EXPO_PUBLIC_AI_MODEL=qwen/qwen3.8-27b
# Modelo con visión para leer recetas (debe aceptar imágenes)
EXPO_PUBLIC_AI_VISION_MODEL=qwen/qwen3.8-27b

# Ejemplos:
# OpenRouter
# EXPO_PUBLIC_AI_BASE_URL=https://openrouter.ai/api/v1
# EXPO_PUBLIC_AI_MODEL=meta-llama/llama-3.3-70b-instruct
#
# Groq
# EXPO_PUBLIC_AI_BASE_URL=https://api.groq.com/openai/v1
# EXPO_PUBLIC_AI_MODEL=qwen/qwen3.8-27b
