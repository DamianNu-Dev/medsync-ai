{
  "expo": {
    "name": "MedSync AI",
    "slug": "medsync-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "medsync",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medsync.ai",
      "infoPlist": {
        "NSCameraUsageDescription": "MedSync AI usa la cámara para escanear recetas médicas y autocompletar tu tratamiento.",
        "NSPhotoLibraryUsageDescription": "MedSync AI accede a tus fotos para analizar una receta médica que ya tengas guardada."
      }
    },
    "android": {
      "package": "com.medsync.ai",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E3F3EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MedSync AI necesita acceso a tus fotos para analizar recetas médicas.",
          "cameraPermission": "MedSync AI usa la cámara para escanear recetas médicas.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MedSync AI usa la cámara para escanear recetas y verificar que la pastilla esté en la boca.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B6B57",
          "defaultChannel": "medsync-alarm",
          "enableRemoteNotifications": false,
          "sounds": [
            "./assets/alarm.wav"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
