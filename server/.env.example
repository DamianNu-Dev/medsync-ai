# ---------------------------------------------------------------------------
# MedSync AI · Configuración del backend Supabase
# ---------------------------------------------------------------------------
# Copia este archivo como `.env` y completa con tus credenciales de Supabase.
# Estas variables son solo para el servidor (Node.js), NO para la app móvil.

# URL de tu proyecto Supabase (ej: https://xyz.supabase.co)
SUPABASE_URL=

# Clave pública (anon / publishable) de Supabase.
# Project Settings → API Keys → anon public
SUPABASE_ANON_KEY=

# Clave de servicio (service_role / secret).
# Se usa en el servidor para saltar RLS. NUNCA se envía a la app.
# Project Settings → API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Puerto del servidor (por defecto 4000)
PORT=4000
HOST=0.0.0.0
